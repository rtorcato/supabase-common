{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "root": false,
  "extends": ["@rtorcato/repo-tooling/biome"],
  "files": {
    "includes": [
      "!**/.docusaurus",
      "!**/build",
      "!**/node_modules",
      "!**/docs/api",
      "!**/docs/changelog.md",
      "!**/test-results",
      "!**/playwright-report",
      "!**/*.md",
      "!**/*.yaml"
    ]
  },
  "overrides": [
    {
      "includes": ["**/src/css/custom.css"],
      "linter": {
        "rules": {
          "complexity": { "noImportantStyles": "off" },
          "style": { "noDescendingSpecificity": "off" }
        }
      }
    }
  ]
}
